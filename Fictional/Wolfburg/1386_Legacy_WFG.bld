<Floors 1 to 44>
#West block rooms
NB_Room(-100, -100, -47, -75, false, false, true, true)
NB_Room(-100, -75, -47, -50, false, false, true, true)
NB_Room(-100, -50, -47, -25, false, false, true, true)
NB_Room(-100, -25, -47, 0, false, false, true, true)
NB_Room(-100, 0, -47, 25, false, false, true, true)
NB_Room(-100, 25, -47, 50, false, false, true, false)

#East block roons
NB_Room(47, -100, 100, -75, false, true, false, true)
NB_Room(47, -75, 100, -50, false, true, false, true)
NB_Room(47, -50, 100, -25, false, true, false, true)
NB_Room(47, -25, 100, 0, false, true, false, true)
NB_Room(47, 0, 100, 25, false, true, false, true)
NB_Room(47, 25, 100, 50, false, true, false, false) 
