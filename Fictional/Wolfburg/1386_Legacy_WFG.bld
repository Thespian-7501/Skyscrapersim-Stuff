NB_Elevator(0, 44, 18, 3, 2, 0, 50, 5, 1, 3, 1, Wall1, true, 1)

NB_Elevator(0, 44, 5, 2, 3, -20, -66.5, 6, 4, 2, 2, Wall1, false, 3, 26)
